# P1010 default kernel config - union of all symbols required by every
# device in the Freescale P1010 subtarget (Sophos RED 15w Rev.1, HP
# MSM460/MSM466, Aerohive BR200-WP, Enterasys WS-AP3710i / WS-AP3715i,
# Extreme Networks WS-AP3825i, TP-LINK TL-WDR4900 v1, Watchguard Firebox
# T1X, Watchguard Firebox T30 / T30-W).

# CRYPTO & compression
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_HASH_INFO=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_LIBCRC32C=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_REGMAP=y
CONFIG_SGL_ALLOC=y
CONFIG_XXHASH=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZSTD_COMMON=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_GRO_CELLS=y

# Filesystems & I/O
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_UBIFS_FS=y
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_CRC16=y

# MMC/SD host (T30/T30-W on internal SD card)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_HSQ=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_IO_ACCESSORS=y
# CONFIG_MMC_WBSD is not set
CONFIG_MMC_SDHCI_OF_ESDHC=y
CONFIG_MMC_SDHCI_PLTFM=y

# Network & DSA (T30 uses mv88e6085)
CONFIG_NET_DEVLINK=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MV88E6XXX=y
CONFIG_NET_DSA_QCA8K=y
CONFIG_NET_DSA_QCA8K_LEDS_SUPPORT=y
CONFIG_NET_DSA_TAG_QCA=y
CONFIG_PHYLINK=y
CONFIG_QCA83XX_PHY=y
CONFIG_QCOM_NET_PHYLIB=y
CONFIG_REALTEK_PHY=y

# MTD / NAND / CFI
CONFIG_MTD_CFI=y
CONFIG_MTD_NAND_FSL_IFC=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_SPLIT_TPLINK_FW=y
CONFIG_MTD_SPLIT_UIMAGE_FW=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096

# Platform glue
CONFIG_BR200_WP=y
CONFIG_DEFAULT_UIMAGE=y
CONFIG_DMA_NEED_SYNC=y
CONFIG_FIREBOX_T1X=y
# CONFIG_FSL_CORENET_CF is not set
CONFIG_FSL_IFC=y
CONFIG_GPIO_74X164=y
CONFIG_MEMORY=y
CONFIG_NEED_DMA_MAP_STATE=y
CONFIG_PPC_ZIMAGE_LA3000000=y
CONFIG_RED_15W_REV1=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_SPI_BITBANG=y
CONFIG_SPI_GPIO=y
CONFIG_SWIOTLB=y
CONFIG_TL_WDR4900_V1=y
CONFIG_WS_AP3715I=y